{
  "schema_version": "1.0",
  "timezone": "America/Mexico_City",
  "storage_policy": {
    "season_data": "DATA/<sport>/ingestion",
    "market_prices": "ODDS_ARCHIVE only when prospectively used",
    "immutable_source_snapshots": "content-addressed by SHA-256",
    "current_copy": "replaceable pointer/copy under CURRENT",
    "execution_manifests": "immutable manifest per ingestion run"
  },
  "states": [
    "CURRENT_VALID",
    "PROVISIONAL_VALID",
    "INCOMPLETE"
