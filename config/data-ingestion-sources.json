{
  "schema_version": "1.0",
  "timezone": "America/Mexico_City",
  "storage_policy": {
    "season_data": "DATA/<sport>/ingestion",
    "market_prices": "ODDS_ARCHIVE only when prospectively used",
    "immutable_source_snapshots": "content-addressed by SHA-256",
    "current_copy": "replaceable pointer/copy under CURRENT",
    "execution_manifests": "immutable manifest per ingestion run"
  },
  "states": [
    "CURRENT_VALID",
    "PROVISIONAL_VALID",
    "INCOMPLETE"
  ],
  "sports": {
    "NFL": {
      "automation": "IMPLEMENTED_PENDING_ONE_TIME_APPS_SCRIPT_DEPLOY",
      "adapter": "bridge/SVL_Data_Ingestion.gs",
      "sources": [
        {
          "key": "schedule",
          "provider": "nflverse/nfldata",
          "url": "https://raw.githubusercontent.com/nflverse/nfldata/master/data/games.csv",
          "format": "csv",
          "required_for_p5": true
        },
        {
          "key": "pbp",
          "provider": "nflverse/nflverse-data",
          "release_api": "https://api.github.com/repos/nflverse/nflverse-data/releases/tags/pbp",
          "asset_pattern": "play_by_play_<season>.csv.gz",
          "format": "csv.gz",
          "required_for_feature_refresh": true,
          "integrity": "provider SHA-256 + size + completed-game-id coverage"
        }
      ]
    },
    "NBA": {
      "automation": "NEEDS_ADAPTER",
      "p5_policy": "Basketball-Reference operational reconciliation; ESPN cross-check; NBA.com official discrepancy verification; SportsDataverse structured enrichment",
      "assessment": "No recurring user upload should be necessary, but CURRENT docs do not pin one canonical machine-download endpoint/artifact for the weekly structured refresh."
    },
    "NHL": {
      "automation": "IMPLEMENTED_PENDING_ONE_TIME_APPS_SCRIPT_DEPLOY",
      "adapter": "bridge/SVL_NHL_Data_Ingestion.gs",
      "season_end_year": 2027,
      "folders": {
        "current": "1J9Mtu1YYwb0808U9BntBSaOdfYxyS_HS",
        "snapshots": "16rfKOBakcPY0wosyVCmdfK1qNmjsr8Bo",
        "manifests": "19fEQRV5L2x-zH1PBKVHjTWlHHy7DPzDp"
      },
      "sources": [
        {
          "key": "schedule",
          "provider": "SportsDataverse/fastRhockey",
          "url": "https://github.com/sportsdataverse/sportsdataverse-data/releases/download/nhl_schedules/nhl_schedule_2027.csv",
          "required": true
        },
        {
          "key": "game_rosters",
          "provider": "SportsDataverse/fastRhockey",
          "url": "https://github.com/sportsdataverse/sportsdataverse-data/releases/download/nhl_game_rosters/game_rosters_2027.csv",
          "required": true
        },
        {
          "key": "team_box",
          "provider": "SportsDataverse/fastRhockey",
          "url": "https://github.com/sportsdataverse/sportsdataverse-data/releases/download/nhl_team_boxscores/team_box_2027.csv",
          "required": true
        },
        {
          "key": "player_box",
          "provider": "SportsDataverse/fastRhockey",
          "url": "https://github.com/sportsdataverse/sportsdataverse-data/releases/download/nhl_player_boxscores/player_box_2027.csv",
          "required": true
        },
        {
          "key": "pbp_lite",
          "provider": "SportsDataverse/fastRhockey",
          "url": "https://github.com/sportsdataverse/sportsdataverse-data/releases/download/nhl_pbp_lite/play_by_play_lite_2027.csv",
          "required": true
        },
        {
          "key": "scratches",
          "provider": "SportsDataverse/fastRhockey",
          "url": "https://github.com/sportsdataverse/sportsdataverse-data/releases/download/nhl_scratches/scratches_2027.csv",
          "required": false
        },
        {
          "key": "shifts",
          "provider": "SportsDataverse/fastRhockey",
          "url": "https://github.com/sportsdataverse/sportsdataverse-data/releases/download/nhl_shifts/shifts_2027.csv",
          "required": false
        }
      ],
      "optional_unavailable": [
        "nhl_rosters/rosters_2027.* not published; CURRENT roster coverage uses game_rosters_2027"
      ],
      "reconciliation": "Hockey-Reference operational reconciliation; ESPN cross-check; NHL.com official verification",
      "integrity": "provider SHA-256 + size + nonempty schema/game-id coverage; immutable content-addressed snapshots",
      "activation": "Run svlActivateDataIngestion() once in the bound Apps Script project after syncing bridge files."
    },
    "Soccer": {
      "automation": "NEEDS_ADAPTER",
      "p5_policy": "ESPN Soccer Scoreboard by CURRENT league/date; official competition site for discrepancies",
      "league_codes": [
        "ENG.1",
        "ESP.1",
        "ESP.2",
        "GER.1",
        "ITA.1",
        "MEX.1"
      ],
      "assessment": "HTTP/date-window adapter is feasible; exact endpoint/schema and official discrepancy routing must be frozen before calling it automatic."
    },
    "Tennis": {
      "automation": "NEEDS_SPORT_SPECIFIC_DISCOVERY_ADAPTER",
      "p5_policy": "ATP Tour official results archive/current tournament results; WTA official tournament scores/matches; Flashscore cross-check",
      "assessment": "Dynamic tournament discovery/identity makes this unsuitable for a simple recurring file fetch. It should still be automated, but with a dedicated ATP/WTA discovery + parser adapter rather than weekly uploads."
    }
  }
}
